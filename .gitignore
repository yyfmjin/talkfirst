# Docker env file with generated secrets (template lives in .env.docker.example)
.env.docker
# The LOCAL docker env file holds the same generated secrets (JWT_SECRET,
# POSTGRES_PASSWORD, ...). It was staged for commit once, which is exactly the
# mistake this line prevents: `.env.docker` was covered but `.env.docker.local`
# was not, and the file's own comment says "generated secrets".
.env.docker.local
# Root Playwright artifact dir (admin one is ignored above)
test-results/

# AI tool session notes (kept local; not part of the product)
.workbuddy-ai/

# `scripts/verify.bat` / `verify.mjs` are product files and stay tracked, but
# their OUTPUT is per-machine diagnostic state, not source: the report names the
# local paths that ran, and the status file is a liveness heartbeat. Neither
# belongs in history.
scripts/verify-report.txt
scripts/verify-status.txt

# Scratch file holding the text for `git commit -F`; removed after the commit.
.git-commit-message.txt

talkfirst-*.tar.gz
