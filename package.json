{
  "name": "talkfirst",
  "private": true,
  "version": "0.1.0",
  "description": "TalkFirst — Talk First. Connect Later.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "_comment-mobile-pins": "2026-10-07 — 根级为什么直接声明了 expo / react-native：apps/mobile 是 Expo SDK 52（expo ~52.0.37 + react-native 0.76.7），但那些 expo 包对 expo 的 peer 范围很宽，npm 的 peer 自动安装会去抓最新版（实测抓到 expo@57 + react-native@0.87.1）。后果不是小毛病：提升到根级的 expo 包按 peer 依赖 import 到 0.87 的 react-native 源码，而做 Flow 转译的是 mobile 那份 0.76 的 babel preset，于是 expo export / eas build 直接挂在 react-native/Libraries/vendor/emitter/EventEmitter.js: ':' or '?' expected —— 即这个 app 从来没在 monorepo 里打通过包。两个 override 让全树只剩一份一致版本；mobile 升 SDK 时把这里一起改。overrides 单独写没用（实测 npm 不重解），必须在这里声明成直接依赖。",
  "overrides": {
    "expo": "~52.0.37",
    "react-native": "0.76.7"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @talkfirst/web",
    "dev:api": "npm run start:dev -w @talkfirst/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:static": "npm run test:static --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "gate": "npm run typecheck && npm run lint && npm run test:static -w @talkfirst/web && npm run test:static -w @talkfirst/admin && npm run test:contracts -w @talkfirst/web && npm test -w @talkfirst/api",
    "build": "npm run build --workspaces --if-present",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "docker:build": "docker compose --env-file .env.docker build",
    "docker:up": "docker compose --env-file .env.docker up -d --build",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f",
    "docker:ps": "docker compose --env-file .env.docker ps",
    "docker:reset": "docker compose --env-file .env.docker down -v"
  },
  "devDependencies": {
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "expo": "~52.0.37",
    "react-native": "0.76.7"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/platform-socket.io": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@nestjs/throttler": "^6.6.0",
    "@nestjs/websockets": "^12.0.3",
    "@prisma/client": "^6.6.0",
    "socket.io": "^4.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "npx tsx prisma/seed.ts"
  }
}
