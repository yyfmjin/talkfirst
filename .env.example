# App
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
API_PORT=4000

# Where locally-stored uploads live on disk, and the public base URL the BROWSER
# uses to fetch them. Docker Compose mounts a named volume at /app/uploads and
# sets UPLOAD_DIR accordingly, so media survives a container rebuild.
# UPLOAD_DIR=
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads

# Video upload and transcoding.
#
# VIDEO_MAX_UPLOAD_MB   the largest ORIGINAL a client may send. Bounded by the
#                       proxy, not by this app: Cloudflare rejects a request body
#                       over 100MB before it reaches Nginx, and Nginx needs
#                       `client_max_body_size 100m`. 90 keeps headroom under both.
#                       Raising it past 100 needs a Cloudflare plan change or a
#                       direct-to-origin upload path — editing this alone will not
#                       make a bigger upload work.
# VIDEO_TARGET_MAX_MB   the size we aim for AFTER transcoding. A different number
#                       for a different purpose: disk and viewer download, not
#                       transport. Do not collapse the two into one.
# VIDEO_MAX_WIDTH/HEIGHT  the bounding box for scaling. Aspect ratio is always
#                       preserved and nothing is ever upscaled, so a 1080x1920
#                       portrait clip becomes 608x1080 rather than being squashed
#                       into 1920x1080.
# VIDEO_PROCESSING_TIMEOUT_MS  a single ffmpeg run may not exceed this.
# VIDEO_MAX_CONCURRENT_JOBS    how many transcodes may run at once. Keep at 1 on
#                       a 2 vCPU host: libx264 is already multi-threaded, and
#                       running several starves every other API request.
#
# All have safe defaults; the API starts even if none of them are set.
VIDEO_MAX_UPLOAD_MB=90
VIDEO_TARGET_MAX_MB=15
VIDEO_MAX_WIDTH=1920
VIDEO_MAX_HEIGHT=1080
VIDEO_PROCESSING_TIMEOUT_MS=300000
VIDEO_MAX_CONCURRENT_JOBS=1

# Development defaults.
#
# Every security hardening switch in the API is guarded by one question: "has
# this process explicitly declared itself a development process?" Setting
# NODE_ENV=development (or test) is that declaration, and
# ALLOW_INSECURE_DEFAULTS=true is the explicit equivalent. Anything else --
# including an unset NODE_ENV -- is treated as production and must present real
# secrets, or the API refuses to boot.
#
# So a deployment that forgets NODE_ENV now fails loudly instead of silently
# signing JWTs with a public placeholder, serving session cookies without
# `Secure`, and handing verification codes to unauthenticated callers.
#
# `ALLOW_INSECURE_DEFAULTS=true` is the master override and beats NODE_ENV, so a
# developer can force development mode locally even where NODE_ENV=production is
# set. It is deliberately NOT written here: leaving it unset keeps this template
# safe to copy into production, and setting the variable at all is a decision.
# ALLOW_INSECURE_DEFAULTS=true

# API rate limiting.
#
# THROTTLE_LIMIT moves only the GLOBAL default (120/min/IP). It does NOT reach
# routes that declare their own @Throttle limit -- `POST /auth/login` is 50/min,
# and the browser suites perform ~74 logins, so they cross 50/min regardless of
# this value.
#
# THROTTLE_MULTIPLIER scales EVERY limit, global default and all per-route
# overrides alike (see HttpThrottlerGuard). Leave it unset -- or 1 -- and nothing
# changes. Raise it ONLY for local browser-suite runs: 100 turns login's 50 into
# 5000. It must never be set in a real deployment, and the API now refuses to
# boot with a value above 1 unless NODE_ENV=development (or
# ALLOW_INSECURE_DEFAULTS=true) is also set.
#
# Deliberately left UNSET here: this file is the template people copy into
# production, and shipping the test value is how the defect above stayed hidden.
# Local test runs set it in `.env`, which is git-ignored.

# PostgreSQL
DATABASE_URL=postgresql://talkfirst:talkfirst@localhost:5432/talkfirst?schema=public
DIRECT_URL=postgresql://talkfirst:talkfirst@localhost:5432/talkfirst?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Phase 2)
JWT_SECRET=change-me-in-development
JWT_REFRESH_SECRET=change-me-refresh-in-development

# Object storage (Phase 10)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email (Phase 2+ -- DEPRECATED: the EMAIL_* names below are unused;
# use the SEC-005 MAIL_*/SMTP_* block at the end of this file)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Email verification enforcement (SEC-005)
#
# ENFORCE_EMAIL_VERIFICATION decides whether an account must confirm its e-mail
# before it can use the product:
#   development / test : false -- the flow is exercisable without a mailbox
#   production         : true  -- requires a working SMTP provider
# In production with this on, the API refuses to boot unless MAIL_PROVIDER=smtp
# and the SMTP_* settings are present, so users are never trapped behind mail
# the server cannot send.
ENFORCE_EMAIL_VERIFICATION=false

# Mail transport: console | fake | smtp
#   console -> logs that a message was sent (never the code)
#   fake    -> captures messages in memory (tests)
#   smtp    -> delivers over SMTP (required in production under enforcement)
MAIL_PROVIDER=console

# SMTP credentials. For Gmail (works with an ordinary @gmail.com account):
#
#   MAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false          # 587 uses STARTTLS; `true` is for port 465
#   SMTP_USER=<you>@gmail.com
#   SMTP_PASSWORD=<16-char app password>
#   SMTP_FROM="TalkFirst" <you>@gmail.com
#
# SMTP_PASSWORD is NOT your Google account password: Google blocks plain-password
# SMTP. Create a 16-character App Password at
# https://myaccount.google.com/apppasswords, which requires 2-Step Verification to
# be enabled first. Spaces in the generated value can be left in or removed.
#
# The code that actually sends is `mail/smtp-mail.provider.ts`; nothing reads an
# `EMAIL_*` name (those are deprecated and unused, see the note further up).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=

# AI / Translation (after MVP loop)
AI_API_KEY=
TRANSLATION_API_KEY=

# 社媒动态同步（尚未实现，占位）
SOCIAL_CLIENT_ID=
SOCIAL_CLIENT_SECRET=

# Google 快捷登录
#
# 与上面的 SOCIAL_* 是两件完全不同的事：SOCIAL_* 是给「同步 Instagram/X 动态」
# 预留的，这里是「用 Google 账号登录本站」。不要复用同一组密钥。
#
# 创建步骤见 docs/OAUTH-SETUP.md。要点：
#   - Google Cloud Console -> API 和服务 -> 凭据 -> OAuth 2.0 客户端 ID（Web 应用）
#   - 「已获授权的重定向 URI」必须与下面的回调地址逐字符一致，否则用户会卡在
#     授权页之后，且 Google 只回一个 redirect_uri_mismatch，不指向真因
#   - 三个非敏感范围即可（openid email profile），不需要 Google 审核
#
# GOOGLE_CLIENT_ID / _SECRET：留空 = 不提供 Google 登录（登录页不渲染该按钮），
# 这是合法状态，不是错误配置。只填一个则启动失败——半配置的 provider 会让用户
# 点到一个必然失败的按钮。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API_PUBLIC_URL 是本 API 对公网可见的源。Google 回调地址由它推导
# （${API_PUBLIC_URL}/api/v1/auth/oauth/google/callback），所以生产环境必须
# 是 https，且与上面控制台登记的值完全一致。
# 注意：不要填前端的 APP_URL —— 那是另一个源，会导致 redirect_uri_mismatch。
API_PUBLIC_URL=http://localhost:4000

# OAUTH_PROVIDERS：显式列出要开启的 provider（逗号分隔）。留空则按「配了就开」
# 推导。列出未配置的 provider 会启动失败。
OAUTH_PROVIDERS=

# OAUTH_DEV_PROVIDER：本地开发用的假 OIDC provider，用来在没有真实凭据时端到端
# 跑通整条链路。**生产环境设置为 true 会拒绝启动**，且它在生产下会被二次拒绝。
OAUTH_DEV_PROVIDER=false

# Security Audit Center (Phase O1)
#
# SECURITY_DEVICE_SALT salts the device identifier (a hash of the normalised
# User-Agent) used by DeviceIdentity/DeviceUser. It is never hardcoded and never
# shipped: without it `deviceHash` is NULL everywhere and device correlation is
# silently disabled -- which is why the API now REFUSES TO BOOT in production
# when this is unset. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECURITY_DEVICE_SALT=

# TRUST_PROXY is the number of proxy hops in front of the API (Phase O1-5).
#
# THIS HAS NO SAFE DEFAULT, so it must be stated: the code falls back to 1 in
# production, and trusting a hop that does not exist lets ANY caller forge their
# address by sending an X-Forwarded-For header. `AccessLog.ip` is the field the
# operations console groups by and investigates with, so a wrong value makes the
# audit trail look complete while being attacker-authored. The API refuses to
# boot in production when this is unset.
#
#   0 = API exposed directly (no proxy)   <- what docker-compose.yml describes
#   1 = one reverse proxy in front
#   2 = a CDN in front of a reverse proxy
#
# After changing it, verify: the same client must show the SAME address in
# 访问日志 (后台 → 网站运维 → 访问日志). Also confirm a forged header does not
# change it — curl -H 'X-Forwarded-For: 1.2.3.4' against the API and check that
# the logged address is your real one, not 1.2.3.4.
TRUST_PROXY=0

# Audit-table retention, in days. 0 means keep forever. Unset uses the defaults
# shown. Access logs grow fastest, so they are pruned first; security events are
# the evidentiary record for incidents noticed weeks later, so they are kept far
# longer. A non-numeric value falls back to the default rather than to 0.
# ACCESS_LOG_RETENTION_DAYS=30
# SECURITY_EVENT_RETENTION_DAYS=180
