generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Phase 2: full MVP core models. Later phases only add columns/tables, never rewrite.
model SchemaMeta {
  id        String   @id @default("talkfirst")
  phase     String   @default("15-moments")
  updatedAt DateTime @updatedAt
}

model DiscoverView {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  viewedUserId String   @db.Uuid
  viewDate     DateTime @db.Date
  createdAt    DateTime @default(now())

  @@unique([userId, viewedUserId, viewDate])
  @@index([userId, viewDate])
}

enum UserStatus {
  ACTIVE
  DISABLED
  BANNED
  // Temporary suspension, distinct from a permanent BANNED. Carries an expiry
  // so it can be lifted automatically. Added in Phase A (admin RBAC).
  SUSPENDED
}

// Phase A: real admin roles. `User.isAdmin` is kept as a compatibility field,
// but authorization decisions are made from AdminUser.role.
enum AdminRole {
  SUPER_ADMIN
  MODERATOR
  SUPPORT
  ANALYST
  CONTENT_MANAGER
}

// Admin Audit Infrastructure: who performed an audited action.
//
// The pairing with `AdminAuditLog.adminId` is enforced by a database CHECK
// constraint (see the migration) AND mirrored in `AdminService.recordAudit`:
//   USER   => adminId IS NOT NULL
//   SYSTEM => adminId IS NULL
// So a SYSTEM row can never smuggle in an administrator's id (forgery) and a
// USER row can never lose its actor (an unattributed human action).
enum AuditActorType {
  // A human administrator. `adminId` is always set.
  USER
  // An automated task (scheduler, background job). `adminId` is always NULL.
  // Deliberately NOT modelled as a User row: a fake account would be searchable,
  // could become loginable if a hash check ever loosened, and would pollute
  // user counts.
  SYSTEM
}

enum Gender {
  UNKNOWN
  MALE
  FEMALE
  OTHER
}

enum LanguageType {
  NATIVE
  LEARNING
}

enum LanguageLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  NATIVE
}

enum SocialPlatform {
  INSTAGRAM
  TELEGRAM
  WHATSAPP
  DISCORD
  X
  TIKTOK
  WECHAT
  QQ
  STEAM
  YOUTUBE
  FACEBOOK
  TALKFIRST
}

// Provenance of a Moment row. `DEMO` marks placeholder content created because
// no real platform OAuth/sync integration exists yet; the API and UI must label
// it as such so users never mistake it for real synced activity.
enum MomentSource {
  USER
  DEMO
}

/**
 * A platform whose content can be read through that platform's OFFICIAL API after
 * the member authorises it.
 *
 * Deliberately a separate enum from `SocialPlatform`. `SocialPlatform` is the
 * broader "which network is this moment associated with" vocabulary, and it
 * includes entries that can never be read programmatically (WECHAT, QQ, STEAM)
 * as well as TALKFIRST itself. Reusing it here would let a caller request a sync
 * for a platform that has no readable API, and the compiler would not object.
 *
 * `DOUYIN` and `TIKTOK` are distinct rows on purpose: they are different
 * companies, different developer programmes and different APIs.
 */
enum SocialSyncProvider {
  YOUTUBE
  X
  TIKTOK
  INSTAGRAM
  DOUYIN
}

/**
 * Whether a stored sync connection can still be used.
 *
 * Named with the `SocialSync` prefix rather than `SocialAccountStatus`, which is
 * already taken by the unrelated handle-sharing model above. `NEEDS_REAUTH` is the
 * state that matters: refresh failed or the member revoked access at the provider.
 * The row is KEPT rather than deleted, because deleting it would silently discard
 * the member's sync settings and their previously synced posts, and would make
 * "reconnect" indistinguishable from "bind for the first time" — the UI has to be
 * able to offer the former.
 */
enum SocialSyncStatus {
  ACTIVE
  NEEDS_REAUTH
  REVOKED
}

/** Shape of the media on an external post, normalised across providers. */
enum SocialSyncMediaType {
  TEXT
  IMAGE
  VIDEO
  LINK
}

/**
 * How much an IP ban removes.
 *
 * Two levels, because "block everything" and "block everything except the ability
 * to fix this" are different tools and an operator needs both:
 *
 *   SECONDARY — the IP may still sign in and out. Everything else is refused.
 *               Used when the account holder should be able to reach the app and
 *               understand what happened, or contact support.
 *   PRIMARY   — every request is refused. Used for traffic that has no legitimate
 *               use of the API at all.
 *
 * A two-value enum rather than a boolean `active` flag: adding a third level later
 * must not mean every stored boolean has to be reinterpreted.
 */
enum IpBanLevel {
  SECONDARY
  PRIMARY
}

/**
 * A refused client address.
 *
 * ## Why this is separate from `User.bannedAt`
 *
 * Banning an account and banning an address answer different questions. An account
 * ban follows the person; an address ban catches traffic that may not be signed in
 * at all — scraping, credential stuffing, a flood of 404s. `AccessLog` already
 * stores the resolved address and is indexed on it, so the address is the thing an
 * operator can actually act on when they see abuse.
 *
 * ## Why `ip` is the raw normalised string, not an `inet` column
 *
 * The whole codebase treats an address as an opaque normalised string
 * (`normalizeIp()` in `client-ip.ts`), which is what keeps the ban lookup and the
 * `AccessLog.ip` column byte-identical. Switching this one column to `inet` would
 * introduce a second representation, and the two would eventually disagree — the
 * exact failure this table cannot afford, because a mismatch means a ban silently
 * does nothing.
 *
 * ## Audit
 *
 * Rows are never deleted when a ban is lifted — `liftedAt`/`liftedBy` are set
 * instead, so "why was this address blocked in March" stays answerable. `reason`
 * is mandatory for the same reason a ban without a stated cause is unusable in a
 * review.
 */
model IpBan {
  id      String     @id @default(uuid()) @db.Uuid
  /// Normalised via `normalizeIp()` — the same function `AccessLog.ip` uses.
  ip      String     @db.VarChar(45)
  level   IpBanLevel
  reason  String     @db.VarChar(500)
  /// Null once the acting admin's account is gone; the ban itself survives.
  createdById String? @db.Uuid
  createdBy   AdminUser? @relation("IpBanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt DateTime?
  createdAt DateTime   @default(now())

  /// Set once, and only once, when the ban is lifted. A row with these set is
  /// history rather than an active block.
  liftedAt   DateTime?
  liftedById String?   @db.Uuid
  liftedBy   AdminUser? @relation("IpBanLiftedBy", fields: [liftedById], references: [id], onDelete: SetNull)

  /// The lookup the middleware performs on every request.
  @@index([ip, liftedAt])
  @@index([createdAt])
}

/**
 * Site-wide configuration an administrator can change at runtime.
 *
 * ## Why a table rather than more environment variables
 *
 * The support address has to be changeable WITHOUT a deploy: it is the address the
 * app shows members, and an operator locked out of it has to file a ticket against
 * their own deployment. An environment variable would need shell access and a
 * restart for a one-word change.
 *
 * ## Why a generic key/value shape
 *
 * The alternative is a `SiteConfig` table with one column per setting, which means
 * a migration for every new string an operator wants to edit. Keys are namespaced
 * (`feedback.email`) so a reader can tell what owns the row, and `value` is text
 * because everything here is a human-entered string. Each consumer validates its
 * own key rather than this table trying to type them all.
 */
model AppSetting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  /// Null when the last writer's admin account was removed.
  updatedById String? @db.Uuid

  @@index([key])
}

/**
 * Handling state of a piece of member feedback.
 *
 * `OPEN` and `IN_PROGRESS` are distinguished because "we have not looked at it" and
 * "someone is on it" are the two things a member most wants to know, and collapsing
 * them makes the queue look untouched while it is being worked.
 */
enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/** What kind of feedback this is, so the queue can be triaged without reading it. */
enum FeedbackKind {
  SUGGESTION
  BUG
  COMPLAINT
  OTHER
}

/**
 * A member's message to the team.
 *
 * ## Why the content is kept even after the account is gone
 *
 * `userId` is nullable and `onDelete: SetNull`, unlike almost every other
 * user-owned table here. Feedback is a record of a product problem: deleting an
 * account must not delete the evidence that five people reported the same bug. The
 * contact address, when the member supplied one, survives too — that is what makes
 * a reply possible at all.
 *
 * ## Why `replyBody` is a column rather than a thread table
 *
 * The mature shape for support is a ticket with many messages. This is deliberately
 * the smaller thing the product asked for: one member message and one team reply.
 * A thread table would be justified the moment a back-and-forth is needed, and the
 * `repliedAt`/`repliedById` pair is what a migration would read to build it. Adding
 * it now would be a guess about a workflow nobody has described.
 *
 * ## Why `contactEmail` is stored apart from `User.email`
 *
 * The member chooses the address they want a reply at, and may want it to differ
 * from the account address — or may not be signed in at all in a future variant.
 * Copying `User.email` into this field at submission time also keeps the reply
 * address stable if the account address later changes.
 */
model Feedback {
  id           String         @id @default(uuid()) @db.Uuid
  /// Null once the submitting account is deleted; the report itself survives.
  userId       String?        @db.Uuid
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind         FeedbackKind   @default(OTHER)
  body         String         @db.Text
  /// Optional reply address the member typed. Validated as an address, never required.
  contactEmail String?        @db.VarChar(320)
  /// Page or feature the member was looking at, when the client can supply it.
  source       String?        @db.VarChar(128)
  status       FeedbackStatus @default(OPEN)
  /// The single team reply. Null until someone answers.
  replyBody    String?        @db.Text
  repliedAt    DateTime?
  repliedById  String?        @db.Uuid
  /// Null once the replying admin's record is removed; the reply text stays.
  repliedBy    AdminUser?     @relation("FeedbackRepliedBy", fields: [repliedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  /// The admin queue reads by status, newest first.
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}


/**
 * An external post, cached locally.
 *
 * Nothing here is fetched on read: the profile page only ever reads PostgreSQL
 * (see the sync strategy). `hidden` is the member's per-post visibility choice and
 * `importedMomentId` records that the member chose to copy this into a native
 * moment, which is the ONLY path that creates a TalkFirst `Moment` from a third
 * party — nothing is imported automatically.
 */
model SocialSyncPost {
  id              String              @id @default(uuid()) @db.Uuid
  socialAccountId String              @db.Uuid
  socialAccount   SocialSyncAccount   @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  // Denormalised so a profile read does not have to join through SocialSyncAccount
  // for the origin badge, and so a post keeps its label if the account is unbound.
  provider        SocialSyncProvider
  externalPostId  String              @db.VarChar(255)
  externalUrl     String            @db.VarChar(1000)
  authorId        String?           @db.VarChar(255)
  authorName      String?           @db.VarChar(255)
  authorAvatar    String?           @db.VarChar(1000)
  text            String?           @db.Text
  title           String?           @db.VarChar(500)
  mediaType       SocialSyncMediaType @default(TEXT)
  thumbnailUrl    String?           @db.VarChar(1000)
  mediaUrl        String?           @db.VarChar(1000)
  // Preferred over `mediaUrl` when the provider offers one: an embed renders the
  // provider's own player, so no bytes are copied and the provider's terms apply.
  embedUrl        String?           @db.VarChar(1000)
  publishedAt     DateTime
  // The provider's own payload, kept for debugging and re-normalisation. Never
  // returned to a client verbatim — it can carry fields we did not intend to expose.
  rawData         Json?
  hidden          Boolean           @default(false)
  importedMomentId String?          @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  /**
   * The deduplication key. A repeat sync of the same post UPDATEs this row instead
   * of creating a second one, so counts and per-post choices survive re-syncs.
   *
   * `socialAccountId` is part of it (rather than just provider + externalPostId) so
   * two members who both follow the same public account each keep their own row
   * with their own `hidden` and `importedMomentId`.
   */
  @@unique([socialAccountId, provider, externalPostId])
  @@index([socialAccountId, publishedAt])
  @@index([socialAccountId, hidden])
}

/**
 * A member's authorised connection to one external social account.
 *
 * ## Why this is not `OAuthIdentity`
 *
 * `OAuthIdentity` answers "how does this person sign in" and stores no token. This
 * model answers "what may TalkFirst read on their behalf" and stores tokens. Merging
 * them would mean a revoked sign-in provider also destroyed the ability to sync, and
 * a sync scope change would touch the login path — so they stay separate tables with
 * separate lifecycles, and nothing here is readable by the auth flow.
 *
 * ## Token handling
 *
 * `*TokenEnc` holds an AES-256-GCM envelope produced by `TokenCryptoService`; the
 * plaintext never reaches the database, a log line or an API response. The column
 * name ends in `Enc` so that a reader cannot mistake it for a raw token.
 *
 * ## Why `userId` AND `providerUserId` are both in uniqueness constraints
 *
 * `[userId, provider]` enforces one connection per platform per member, which is
 * what the settings screen shows. `[provider, providerUserId]` stops the same
 * external account being bound twice by different members in a way that would make
 * a provider rate limit apply to the wrong connection.
 */
model SocialSyncAccount {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @db.Uuid
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        SocialSyncProvider
  providerUserId  String              @db.VarChar(255)
  handle          String?             @db.VarChar(255)
  displayName     String?             @db.VarChar(255)
  avatarUrl       String?             @db.VarChar(1000)

  accessTokenEnc  String              @db.Text
  refreshTokenEnc String?             @db.Text
  /** Space-separated, exactly as the provider granted them. */
  scope           String?             @db.Text
  tokenExpiresAt  DateTime?

  /**
   * How many recent posts to keep, 1..3.
   *
   * The range is enforced by a CHECK constraint in the migration as well as in the
   * service layer, because this is a policy the product promised and a service-layer
   * check is bypassed by any direct SQL path.
   */
  syncLimit       Int                 @default(3)
  syncEnabled     Boolean             @default(true)
  status          SocialSyncStatus @default(ACTIVE)
  lastSyncedAt    DateTime?
  /** Short, already-translated code for the settings screen; never a raw provider error. */
  lastSyncError   String?             @db.VarChar(64)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  syncPosts       SocialSyncPost[]

  @@unique([userId, provider])
  @@unique([provider, providerUserId])
  @@index([userId])
  // Read by the background sync to find due connections without scanning the table.
  @@index([status, syncEnabled, lastSyncedAt])
}


enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ConnectionStatus {
  ACTIVE
  REMOVED
}

enum ExchangeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

// PC-1.2 Profile Attributes: separates "about me" from "who I want to meet".
// Both live in one table discriminated by `kind`, so a query that forgets the
// discriminator cannot silently merge the two concepts.
enum AttributeKind {
  ABOUT_ME
  LOOKING_FOR
}

// Provenance of a tag. `SYSTEM` = shipped (or promoted) by the product and
// admin-manageable; `CUSTOM` = typed by a user and owned only by that user.
enum AttributeSource {
  SYSTEM
  CUSTOM
}

// Shape hint for the definition catalog. `BOOLEAN` means the label is
// self-contained (e.g. "桌游"); the others expect `UserAttribute.value`.
enum AttributeValueType {
  BOOLEAN
  TEXT
  SINGLE_SELECT
  MULTI_SELECT
}

// Profile field visibility tiers. Governs PROFILE fields only: SocialAccount
// handles remain authorized exclusively by SharedSocialAccount.
enum Visibility {
  PUBLIC
  CONNECTIONS
  PRIVATE
}

// Row-level moderation state for user-authored attributes. `ReportStatus` is
// report-scoped and cannot express "this single attribute is withdrawn".
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

/**
 * A third-party identity provider a member can sign in with.
 *
 * Only Google is wired up. The enum exists rather than a free-text column so a
 * second provider is a migration that adds a value — not a string that can drift
 * into three spellings in the database, which is what happened to
 * `VerificationCode.purpose` and is why that one carries a comment about it.
 */
enum OAuthProvider {
  GOOGLE
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  // Emails are stored lowercase (normalized in the service layer), and remain
  // REQUIRED: every sign-up path needs one. Phone-only accounts were considered
  // and deferred, so this stays non-null and the "at least one identifier"
  // invariant does not exist yet.
  email         String     @unique
  /**
   * The account name used to SIGN IN. `nickname` is the display name — the two
   * are deliberately separate things (P0-02).
   *
   * Required and unique, and stored lower-case by `common/username.ts` rather
   * than relying on a functional unique index: `Alice` must not be able to
   * coexist with `alice`, because the two render identically in most fonts and
   * that is an impersonation vector. Normalising on the way in also means lookup
   * needs no case handling.
   *
   * Every account has one: registration generates one when the field is omitted,
   * and the migration that added this column backfilled the accounts that already
   * existed (they had never been asked for a name).
   *
   * Scope note: it is part of the OWNER's session payload and is shown on `/me`.
   * It is deliberately NOT part of the public-profile projection — surfacing an
   * account name that also works as a login identifier to other members is a
   * privacy decision with its own threat model (targeted guessing), and it is not
   * made here.
   *
   * There is deliberately NO database-side default. One was tried
   * (`dbgenerated('lower(substr(md5(random()::text || clock_timestamp()::text), 1, 10))')`)
   * and removed again: PostgreSQL re-renders the parsed expression, so
   * introspection returned a differently parenthesised string and
   * `prisma migrate diff` reported drift forever — meaning every later
   * `migrate dev` would have proposed a meaningless migration. The column's
   * invariant is therefore the application's to keep, and every caller passes a
   * name (`common/username.ts`).
   */
  username      String     @unique @db.VarChar(30)
  /**
   * Nullable because a Google-only account has no password to store.
   *
   * This used to be `String` and every consumer assumed it. Writing a random
   * hash for an OAuth account was the tempting shortcut and is wrong: it is a
   * fabricated credential — `bcrypt.compare` would run against it on every login
   * attempt, and nothing downstream could tell "this account has no password"
   * from "this account has a password nobody knows". `NULL` states the fact, and
   * the three readers that assumed otherwise (`login`, `changePassword`,
   * `resetPassword`) now branch on it explicitly.
   */
  passwordHash  String?
  emailVerified Boolean    @default(false)
  status        UserStatus @default(ACTIVE)

  nickname    String?
  avatarUrl   String?
  birthDate   DateTime? @db.Date
  countryCode String?   @db.Char(2)
  city        String?
  region      String?   @db.VarChar(80)
  gender      Gender    @default(UNKNOWN)
  bio         String?   @db.VarChar(500)

  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  languages                UserLanguage[]
  interests                UserInterest[]
  purposes                 UserPurpose[]
  preferredCountries       UserPreferredCountry[]
  socialAccounts           SocialAccount[]
  // Feedback this member submitted. Kept `SetNull` on delete, so the product problem
  // outlives the account that reported it.
  feedback                 Feedback[]
  // Authorised external-account connections used for CONTENT SYNC. A different
  // concept from `socialAccounts` directly above, which is the handle-sharing
  // model: this one carries OAuth tokens, that one carries sharing grants.
  socialSyncAccounts       SocialSyncAccount[]
  momentBindings           MomentPlatformBinding[]
  momentSetting            MomentSetting?
  moments                  Moment[]
  momentLikes              MomentLike[]
  /**
   * 送花（虚拟礼物，2026-10-06）—— 点赞式的人对人动作。
   *
   * 一条 `UserFlower` = 「A 给过 B 一朵花」。复合主键保证同一对只有一条，
   * 所以再点一次是**收回**而不是叠加 —— 与 `MomentLike` 同一形状。
   */
  flowersSent              UserFlower[]            @relation("FlowerSender")
  flowersReceived          UserFlower[]            @relation("FlowerReceiver")
  /**
   * 收到的花的朵数（冗余计数）。
   *
   * 与 `Moment.likeCount` 同一取向：读资料时不为一个数字做聚合查询，写时在同一事务里增减。
   * **它是派生值** —— 万一与 `flowersReceived` 的行数不一致，以行数为准。
   */
  flowerCount              Int                     @default(0)
  momentBookmarks          MomentBookmark[]
  momentComments           MomentComment[]
  refreshTokens            RefreshToken[]
  // Third-party sign-in identities (Google). One user may hold several.
  oauthIdentities          OAuthIdentity[]
  exchangeRequestsSent     ExchangeRequest[]       @relation("ExchangeSent")
  exchangeRequestsReceived ExchangeRequest[]       @relation("ExchangeReceived")
  sharesGranted            SharedSocialAccount[]   @relation("SharesGranted")
  sharesReceived           SharedSocialAccount[]   @relation("SharesReceived")
  adminNotes               AdminNote[]
  // Phase A RBAC: role record. Optional — a user may be isAdmin without a
  // profile during the compatibility window.
  adminUser                AdminUser?
  auditLogsWritten         AdminAuditLog[]         @relation("AuditByAdmin")
  adminNotesWritten        AdminNote[]             @relation("NotesByAdmin")

  isAdmin        Boolean   @default(false)
  bannedAt       DateTime?
  banReason      String?   @db.VarChar(500)
  // Temporary suspension expiry (Phase A). Null for permanent bans.
  suspendedUntil DateTime?

  sentRequests     ConnectionRequest[]  @relation("SentRequests")
  receivedRequests ConnectionRequest[]  @relation("ReceivedRequests")
  connectionsA     Connection[]         @relation("ConnectionsA")
  connectionsB     Connection[]         @relation("ConnectionsB")
  memberships      ConversationMember[]
  messages         Message[]            @relation("SentMessages")
  reportsMade      Report[]             @relation("ReportsMade")
  reportsReceived  Report[]             @relation("ReportsReceived")
  blocksMade       Block[]              @relation("BlocksMade")
  blocksReceived   Block[]              @relation("BlocksReceived")
  notifications    Notification[]
  attributes        UserAttribute[]
  fieldVisibilities ProfileFieldVisibility[]
  // Security Audit Center (P1): security events attributed to this user.
  securityEvents    SecurityEvent[]

  @@index([status])
  @@index([countryCode])
  @@index([createdAt])
}

// Phase A RBAC. One row per administrator, attached to an existing User so the
// admin identity reuses the normal auth/session machinery instead of a parallel
// user table. `User.isAdmin` is retained for backwards compatibility; role
// decisions read from here.
model AdminUser {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      AdminRole @default(MODERATOR)
  // Soft-disable instead of deleting, so audit history stays intact.
  isActive  Boolean   @default(true)
  // Who granted this role — makes privilege grants themselves auditable.
  createdBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([role])
  @@index([isActive])

  // IP bans this admin created, and ones they lifted. Two named relations rather
  // than one, because "who blocked this address" and "who unblocked it" are
  // separate facts that an audit has to be able to read independently.
  ipBansCreated IpBan[] @relation("IpBanCreatedBy")
  ipBansLifted  IpBan[] @relation("IpBanLiftedBy")

  feedbackReplied Feedback[] @relation("FeedbackRepliedBy")
}

model VerificationCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String
  purpose    String    @default("REGISTER") @db.VarChar(16)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, purpose, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  // SEC-003-B reuse detection. Set only when this token was revoked *because it
  // was rotated* into a successor. A token revoked any other way (logout,
  // password change, admin revoke) keeps this NULL. Replaying a token that has
  // both `revokedAt` and `replacedById` is therefore a reuse signal; replaying a
  // deliberately-revoked one is just an ordinary invalid refresh token.
  replacedById String?  @db.Uuid
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/**
 * A member's third-party sign-in identity — "this Google account is this user".
 *
 * ## Why a table and not `User.googleId`
 *
 * A second provider would otherwise be another nullable column plus another
 * partial index, and the login query would grow a branch per provider. One row
 * per (provider, account) keeps both the lookup and the schema flat.
 *
 * ## Why the lookup key is `(provider, providerUserId)` and never the e-mail
 *
 * The provider's `sub` claim is the stable identifier. The e-mail is a
 * *snapshot* of what the provider told us at sign-in: it can change at the
 * provider, and a member may later change their TalkFirst address. Matching on
 * it would mean a provider-side address change silently logs someone into the
 * wrong account, or locks them out of their own. `email` is therefore stored for
 * support and display only.
 */
model OAuthIdentity {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       OAuthProvider
  // The provider's own immutable subject claim (`sub`). 255 chars because a
  // provider is free to choose its format and Google's is a 21-digit string.
  providerUserId String        @db.VarChar(255)
  // Snapshot of the address the provider reported, lowercased. Display/support
  // only — never a lookup key (see the model comment).
  email          String?       @db.VarChar(320)
  // True only when the provider itself asserted the address is verified. A false
  // here must never be treated as a verified address; the account resolution
  // rule refuses to create or link on one.
  emailVerified  Boolean       @default(false)
  createdAt      DateTime      @default(now())
  lastLoginAt    DateTime?

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Interest {
  id       String         @id @default(uuid()) @db.Uuid
  slug     String         @unique
  name     String
  nameZh   String?
  category String
  sort     Int            @default(0)
  users    UserInterest[]
}

model UserInterest {
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interestId String   @db.Uuid
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

/**
 * A filter tab on 「发现」.
 *
 * ## Why this table exists
 *
 * The three tabs were hardcoded in two places at once — a `FILTERS` array in
 * `apps/web/src/app/discover/page.tsx` and an `if (filter === "language") … else if
 * (filter === "gaming") …` in `DiscoverService.getRecommendations`, with the gaming
 * keywords themselves listed inline
 * (`["minecraft", "valorant", "gta", "steam", …]`). Adding a category therefore required
 * editing the frontend, editing the backend and redeploying, which is exactly why there
 * were only two of them.
 *
 * ## Why `keywords` is a comma-separated string rather than a relation
 *
 * The matching rule is "does this candidate have an interest or purpose whose slug is in
 * this list", so the list is a small admin-typed vocabulary, not a set of foreign keys. A
 * join table would mean the operator has to create `Interest` rows first — and `Interest`
 * is a member-facing profile vocabulary, so an admin-only filter keyword would pollute it.
 * A string keeps the operator's mental model ("type the words") equal to the storage.
 *
 * Matching is case-insensitive and whitespace-tolerant, and the parsed list is what the
 * service compares against, so a stray space cannot silently make a keyword dead.
 *
 * ## Why `isActive` rather than deletion
 *
 * Deactivating hides a tab without breaking anything that referred to it, which is the
 * same pattern `AttributeDefinition.isActive` already uses in this codebase.
 *
 * ## Why an unknown `slug` filter still works
 *
 * `DiscoverService` treats a filter whose keywords list is empty as "no category filter"
 * and falls back to the previous behaviour for the two built-in slugs. That keeps an
 * existing client working against a database that has not been seeded yet, which is the
 * state a fresh deployment is in.
 */
model DiscoverCategory {
  id        String   @id @default(uuid()) @db.Uuid
  /// Stable identifier used in the query string, e.g. `gaming`.
  slug      String   @unique @db.VarChar(48)
  label     String   @db.VarChar(48)
  labelZh   String?  @db.VarChar(48)
  /// Comma-separated interest/purpose slugs. Empty means the tab is not yet configured.
  keywords  String   @db.Text @default("")
  sort      Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sort])
}

model Purpose {
  id     String        @id @default(uuid()) @db.Uuid
  slug   String        @unique
  name   String
  nameZh String?
  sort   Int           @default(0)
  users  UserPurpose[]
}

model UserPurpose {
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  purposeId String  @db.Uuid
  purpose   Purpose @relation(fields: [purposeId], references: [id], onDelete: Cascade)

  @@id([userId, purposeId])
}

model Language {
  id         String         @id @default(uuid()) @db.Uuid
  code       String         @unique @db.VarChar(8)
  name       String
  nativeName String?
  users      UserLanguage[]
}

model UserLanguage {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageCode String        @db.VarChar(8)
  language     Language      @relation(fields: [languageCode], references: [code], onDelete: Restrict)
  type         LanguageType
  level        LanguageLevel @default(INTERMEDIATE)

  @@unique([userId, languageCode, type])
  @@index([userId])
}

model Country {
  id        String                 @id @default(uuid()) @db.Uuid
  code      String                 @unique @db.Char(2)
  name      String
  flag      String?
  usersWant UserPreferredCountry[]
}

model UserPreferredCountry {
  userId      String  @db.Uuid
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryCode String  @db.Char(2)
  country     Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@id([userId, countryCode])
}

model SocialAccount {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    SocialPlatform
  handle      String         @db.VarChar(128)
  syncEnabled Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  shares SharedSocialAccount[]

  @@unique([userId, platform])
  @@index([userId])
}

// Per-pair authorization: owner grants viewer the right to see ONE account.
// This is the single source of truth for "who may see whose handle".
// Visibility on SocialAccount is only the account's default state and must
// never be treated as proof that a specific viewer is authorized.
model SharedSocialAccount {
  id              String          @id @default(uuid()) @db.Uuid
  ownerId         String          @db.Uuid
  owner           User            @relation("SharesGranted", fields: [ownerId], references: [id], onDelete: Cascade)
  viewerId        String          @db.Uuid
  viewer          User            @relation("SharesReceived", fields: [viewerId], references: [id], onDelete: Cascade)
  platform        SocialPlatform
  socialAccountId String          @db.Uuid
  socialAccount   SocialAccount   @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  exchangeId      String          @db.Uuid
  exchange        ExchangeRequest @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())

  @@unique([ownerId, viewerId, platform])
  @@index([viewerId, ownerId])
  @@index([ownerId])
  @@index([exchangeId])
}

model MomentPlatformBinding {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    SocialPlatform
  handle      String         @db.VarChar(128)
  displayName String?        @db.VarChar(128)
  syncEnabled Boolean        @default(true)
  connectedAt DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

model MomentSetting {
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncEnabled     Boolean  @default(false)
  visibleTo       String   @default("everyone") @db.VarChar(16)
  filterSensitive Boolean  @default(true)
  showPhotos      Boolean  @default(true)
  showVideos      Boolean  @default(true)
  showTexts       Boolean  @default(true)
  showReels       Boolean  @default(true)
  showLives       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@id([userId])
}

model Moment {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     SocialPlatform
  platformName String?         @db.VarChar(32)
  content      String          @db.VarChar(2000)
  images       String[]        @default([])
  videoUrl     String?         @db.VarChar(2000)
  durationSec  Int?
  tags         String[]        @default([])
  likeCount    Int             @default(0)
  commentCount Int             @default(0)
  // Where this moment came from. `USER` = the user published it in-app.
  // `DEMO` = placeholder content generated when a platform handle is bound,
  // because no real OAuth integration exists yet. Demo rows must never be
  // presented as genuine synced activity.
  source       MomentSource    @default(USER)
  /**
   * Moderation state, decided at publish time by `SafetyService`.
   *
   * ## Why this is a column rather than a queue table
   *
   * The state belongs to the moment and changes in place; a separate queue row would
   * have to be kept in step with it and could disagree. `PENDING` is the only state
   * that hides content from others, and it is set by the scanner, not by a human.
   *
   * ## Why the default is APPROVED
   *
   * Defaulting to PENDING would put every publish behind a human, which is a product
   * decision nobody made and would empty the feed on day one. The scanner escalates the
   * narrow cases it recognises instead — the shape every large platform uses, because
   * the alternative is a queue that grows faster than it can be worked.
   *
   * Existing rows are backfilled to APPROVED by the migration: they were published
   * under the old rule (everything visible), and silently hiding history would be a
   * worse outcome than leaving it.
   */
  reviewStatus ReviewStatus    @default(APPROVED)
  /** Reasons the scanner recorded, for the reviewer. Never shown to other members. */
  reviewReasons String[]       @default([])
  reviewedAt   DateTime?
  reviewedById String?         @db.Uuid
  syncedAt     DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  likes        MomentLike[]
  bookmarks    MomentBookmark[]
  comments     MomentComment[]

  @@index([userId, createdAt])
  @@index([platform, createdAt])
  @@index([createdAt])
  /// The moderation queue reads by status, oldest first (FIFO), so the index matches.
  @@index([reviewStatus, createdAt])
}

model MomentLike {
  momentId  String   @db.Uuid
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([momentId, userId])
  @@index([userId])
}

/**
 * 送花（虚拟礼物）—— 人对人的一次性动作，形状刻意与 `MomentLike` 一致。
 *
 * ## 为什么是复合主键而不是 `id`
 *
 * 「点赞」这个语义本身就包含「同一对只有一次」：复合主键把这条不变式写在数据库里，
 * 应用层不需要先查再写，也不存在两个并发请求各插一条的窗口。
 *
 * ## 两个关系必须具名
 *
 * `sender` / `receiver` 都指向 `User`，不具名时 Prisma 无法区分，
 * 会在生成客户端时直接报错。
 */
model UserFlower {
  senderId   String   @db.Uuid
  sender     User     @relation("FlowerSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String   @db.Uuid
  receiver   User     @relation("FlowerReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([senderId, receiverId])
  /// 谁的收花列表 / 计数：按收花人 + 时间读。
  @@index([receiverId, createdAt])
}

// C4 — one row per (user, moment) the user saved for later.
//
// `id` rather than a composite primary key like `MomentLike`: the saved list
// paginates by "bookmarked most recently", and that uses the shared
// `(createdAt, id)` keyset cursor (`apps/api/src/common/keyset-cursor.ts`).
// A composite key carries no `id` to break a timestamp tie with, so bookmarks
// would need a second cursor shape of their own — which is exactly the kind of
// divergence the shared helper exists to prevent.
//
// Uniqueness of `(userId, momentId)` is therefore expressed as a unique index.
// `CASCADE` on both sides matches `MomentLike`: deleting a moment (or a user)
// takes their bookmarks with it, and a bookmark is not worth keeping once its
// target is gone.
model MomentBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  momentId  String   @db.Uuid
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, momentId])
  @@index([userId, createdAt])
}

model MomentComment {
  id        String   @id @default(uuid()) @db.Uuid
  momentId  String   @db.Uuid
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  // PC-2.3.1 — one reply level only. A top-level comment leaves this NULL; a
  // reply points at a top-level comment. "No nesting under a reply" spans two
  // rows, so it stays an application-level rule (the service rejects a parent
  // whose own parentCommentId is not null).
  parentCommentId String?        @db.Uuid
  parentComment   MomentComment? @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         MomentComment[] @relation("CommentReplies")

  @@index([momentId, createdAt])
  @@index([userId])
  @@index([parentCommentId])
}

model ConnectionRequest {
  id         String        @id @default(uuid()) @db.Uuid
  senderId   String        @db.Uuid
  sender     User          @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String        @db.Uuid
  receiver   User          @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  message    String?       @db.VarChar(200)
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([senderId, status])
  @@index([receiverId, status])
  @@index([senderId, receiverId, createdAt])
}

model Connection {
  id             String           @id @default(uuid()) @db.Uuid
  userAId        String           @db.Uuid
  userA          User             @relation("ConnectionsA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId        String           @db.Uuid
  userB          User             @relation("ConnectionsB", fields: [userBId], references: [id], onDelete: Cascade)
  conversationId String?          @unique @db.Uuid
  conversation   Conversation?    @relation("ConnectionConversation", fields: [conversationId], references: [id], onDelete: SetNull)
  status         ConnectionStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Conversation {
  id         String               @id @default(uuid()) @db.Uuid
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  members    ConversationMember[]
  messages   Message[]
  connection Connection?          @relation("ConnectionConversation")
  exchanges  ExchangeRequest[]
}

model ConversationMember {
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  /**
   * C3 — 这位成员最后一次「看到这里」的时间。
   *
   * 未读数 = 本会话中 `createdAt > lastReadAt` 且**不是我发的**、且不是 SYSTEM 的消息数。
   * 存在成员行上而不是 Conversation 上：同一个会话的两个成员各自读完到不同位置，
   * 这是双人会话里唯一能表达「谁读到哪了」的位置。
   *
   * `null` = 从未读过一眼（新加入的成员）。注意它不是「全部未读」的代名词 ——
   * 计数会排除 SYSTEM 消息，而建会话时正好只有一条 SYSTEM 消息。
   */
  lastReadAt     DateTime?

  @@id([conversationId, userId])
}

model Message {
  id             String               @id @default(uuid()) @db.Uuid
  conversationId String               @db.Uuid
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String               @db.Uuid
  sender         User                 @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String               @db.VarChar(2000)
  type           MessageType          @default(TEXT)
  createdAt      DateTime             @default(now())
  deletedAt      DateTime?
  translations   MessageTranslation[]

  @@index([conversationId, createdAt])
}

model MessageTranslation {
  id         String   @id @default(uuid()) @db.Uuid
  messageId  String   @db.Uuid
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sourceLang String   @db.VarChar(8)
  targetLang String   @db.VarChar(8)
  text       String   @db.VarChar(2000)
  provider   String   @db.VarChar(32)
  createdAt  DateTime @default(now())

  @@unique([messageId, targetLang])
  @@index([messageId])
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  reporter       User         @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String       @db.Uuid
  reportedUser   User         @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  messageId      String?      @db.Uuid
  momentId       String?      @db.Uuid
  /**
   * C2 — 被举报的那条评论。与 `momentId` / `messageId` 同一形状：**裸 UUID，没有外键**。
   *
   * 那两列本来就没有外键（已在 P0-00 的 P2 清单里），这里跟邻居保持一致。
   * 不过对评论来说「没有外键」恰好也是想要的语义：举报是**审核历史**，
   * 评论被删（`MomentComment` 是硬删除）之后这条举报仍应存在且可复核 ——
   * 加了 `onDelete: Cascade` 反而会把审核记录一起删掉。
   */
  commentId      String?      @db.Uuid
  reason         String       @db.VarChar(64)
  description    String?      @db.VarChar(1000)
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())

  @@index([reportedUserId, status])
  @@index([status, createdAt])
  @@index([momentId])
  @@index([commentId])
}

model Block {
  blockerId String   @db.Uuid
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @db.Uuid
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

model AdminNote {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String   @db.Uuid
  // Phase A: real FK so notes can never point at a deleted admin (audit chain).
  admin     User     @relation("NotesByAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid

  // Admin Audit Infrastructure: who acted. Defaults to USER so every row written
  // before this change keeps its exact meaning with no data migration.
  actorType  AuditActorType @default(USER)

  // Nullable since the Admin Audit Infrastructure phase: NULL means the platform
  // itself performed the action, never a human. The CHECK constraint added in
  // migration 20260917153000_admin_audit_system_actor enforces the pairing with
  // `actorType`, so `SYSTEM + adminId` (forgery) and `USER + NULL` (an
  // unattributed human action) are both unrepresentable at the database level.
  adminId    String?  @db.Uuid
  // Phase A: real FK. Restrict (not Cascade) so audit rows survive and an admin
  // account cannot be deleted out from under its own audit trail. Unchanged by
  // the nullable widening — Postgres does not apply FK checks to NULLs, so
  // SYSTEM rows are simply unconstrained while human rows keep the guarantee.
  admin      User?    @relation("AuditByAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  action     String   @db.VarChar(64)
  // Phase A: what kind of thing was targeted (USER / REPORT / EXCHANGE / ...),
  // so targetId is interpretable.
  targetType String?  @db.VarChar(32)
  // Phase A: widened from UUID to text so non-UUID targets (e.g. setting keys)
  // can be recorded. Existing values are all UUIDs and convert losslessly.
  targetId   String?  @db.VarChar(128)
  // Phase A: structured reason, no longer buried in free-text `detail`.
  reason     String?  @db.VarChar(500)
  // Phase A: before/after snapshots of the mutated fields.
  before     Json?
  after      Json?
  // Phase A: request environment for forensics.
  ip         String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(512)
  // Retained for backwards compatibility with pre-Phase-A rows.
  detail     String?  @db.VarChar(2000)
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(32)
  title     String    @db.VarChar(128)
  body      String?   @db.VarChar(500)
  data      String?   @db.VarChar(2000)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model ExchangeRequest {
  id             String           @id @default(uuid()) @db.Uuid
  connectionId   String           @db.Uuid
  conversationId String           @db.Uuid
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requesterId    String           @db.Uuid
  requester      User             @relation("ExchangeSent", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId     String           @db.Uuid
  receiver       User             @relation("ExchangeReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  platforms      SocialPlatform[]
  message        String?          @db.VarChar(200)
  status         ExchangeStatus   @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  shares SharedSocialAccount[]

  @@index([conversationId, status])
  @@index([requesterId, status])
  @@index([receiverId, status])
}

// PC-1.2 Profile Attributes.
//
// Single tag catalog for both product-shipped tags and promoted user tags.
// `scope` distinguishes the two; `isActive` lets an admin stop offering a tag
// without deleting it, so existing user selections keep resolving (Q10).
model AttributeDefinition {
  id           String             @id @default(uuid()) @db.Uuid
  key          String             @unique @db.VarChar(64)
  scope        AttributeSource    @default(SYSTEM)
  kind         AttributeKind
  category     String             @db.VarChar(32)
  label        String             @db.VarChar(32)
  labelZh      String?            @db.VarChar(32)
  valueType    AttributeValueType @default(BOOLEAN)
  sort         Int                @default(0)
  isActive     Boolean            @default(true)
  isSearchable Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  userAttributes UserAttribute[]

  @@index([kind, isActive])
  @@index([category])
}

// One row per user selection, for both system-backed and user-authored tags.
//
// Deletion semantics are deliberate: `definitionId` is `SetNull`, so deleting a
// definition degrades its rows to custom-style rows instead of destroying user
// data. Rows are only removed by deleting the owning `User` (Q10).
model UserAttribute {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         AttributeKind
  // Set for SYSTEM selections and promoted tags; NULL for plain custom labels.
  definitionId String?             @db.Uuid
  definition   AttributeDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  label        String?             @db.VarChar(32)
  // Normalized copy of `label` (NFKC + trim + collapse whitespace + casefold).
  // Uniqueness is enforced on this key, never on the display casing (Q12).
  labelKey     String?             @db.VarChar(32)
  value        String?             @db.VarChar(80)
  visibility   Visibility          @default(PUBLIC)
  sortOrder    Int                 @default(0)
  reviewStatus ReviewStatus        @default(APPROVED)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([userId, definitionId])
  @@unique([userId, kind, labelKey])
  @@index([userId, kind])
  @@index([reviewStatus])
  @@index([definitionId])
}

// Per-field profile visibility. One row per (user, field); an absent row means
// "use the default", so existing accounts need no backfill (Q5, Q9).
//
// SocialAccount handles are intentionally NOT listed here: they stay authorized
// per-pair by SharedSocialAccount and must never be governed by this table.
//
// `fieldKey` is a plain string rather than an enum so a new visibility-governed
// profile field needs no schema change.
model ProfileFieldVisibility {
  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldKey   String     @db.VarChar(32)
  visibility Visibility @default(PUBLIC)
  updatedAt  DateTime   @updatedAt

  @@id([userId, fieldKey])
  @@index([fieldKey, visibility])
}

// ---------------------------------------------------------------------------
// Security Audit Center (P1)
//
// Why a new table instead of AdminAuditLog: `AdminAuditLog` cannot represent an
// anonymous actor. Its CHECK constraint requires `adminId NOT NULL` whenever
// `actorType = USER`, and `adminId` is an FK to `User`. Security events are
// overwhelmingly anonymous (a failed login for an unknown e-mail, a throttled
// request before authentication), so they need their own table. AdminAuditLog is
// left untouched and keeps meaning exactly what it did before.
// ---------------------------------------------------------------------------

/// A security-relevant observation: an auth outcome, a throttle hit, a
/// suspicious pattern, an admin action, etc.
model SecurityEvent {
  id String @id @default(uuid()) @db.Uuid

  // String unions rather than Prisma enums, matching the convention used by
  // `AdminAuditLog.action` and `ProfileFieldVisibility.fieldKey`. Adding a new
  // event type or source must not require a database migration.
  type   String @db.VarChar(48)
  // AUTH | THROTTLE | ACCESS | MODERATION | ADMIN | SYSTEM
  source String @db.VarChar(16)

  // LOW | MEDIUM | HIGH | CRITICAL
  riskLevel String @db.VarChar(8)
  riskScore Int    @default(0)
  factors   Json?

  // SetNull rather than Cascade: a deleted account must not erase the security
  // history that explains what happened before it was deleted.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  ip         String? @db.VarChar(45)
  // A device *identifier* derived from a salted hash of the User-Agent. It is
  // not a fingerprint and must never on its own be used to judge a user.
  deviceHash String? @db.VarChar(64)
  userAgent  String? @db.VarChar(512)
  method     String? @db.VarChar(8)
  path       String? @db.VarChar(256)
  statusCode Int?
  // Correlates this event with the AccessLog row for the same request.
  requestId  String? @db.VarChar(64)

  success Boolean @default(true)
  // Already redacted by SecurityEventService before it reaches the database.
  detail  Json?

  handledAt DateTime?
  handledBy String?   @db.Uuid
  createdAt DateTime  @default(now())

  @@index([type, createdAt])
  @@index([ip, createdAt])
  @@index([userId, createdAt])
  @@index([deviceHash, createdAt])
  @@index([riskLevel, createdAt])
}

/// HTTP access audit. One row per handled request.
///
/// Never stores credentials, tokens, cookies or raw bodies. `queryDigest` is a
/// whitelisted, redacted, size-capped summary — never the raw query string.
model AccessLog {
  id        String @id @default(uuid()) @db.Uuid
  requestId String @db.VarChar(64)

  method String @db.VarChar(8)
  path   String @db.VarChar(256)
  queryDigest String? @db.VarChar(512)

  statusCode Int
  durationMs Int

  userId        String? @db.Uuid
  authenticated Boolean @default(false)
  // True when the request targeted an admin route. Resolving the real role
  // would need a database read on every request, which P1 deliberately avoids.
  isAdmin       Boolean @default(false)
  /**
   * 2026-10-06 — 这条请求属于哪个「渠道」，后台的访问日志默认只看 `USER`。
   *
   * 取值只有三个：
   *   USER  —— 普通成员流量（默认视图，也是 `要看的对象`）
   *   ADMIN —— 命中了后台路由（与 `isAdmin` 同源：按路径判，不做每次请求的角色查询）
   *   OPS   —— 来自服务器自身/环回的请求（探针、运维命令、部署自检）
   *
   * 为什么需要它：运营方要看的是**成员**的访问，而后台自己管后台、服务器被自己探来探去，
   * 会让真实流量淹在噪音里。分流之后这些行仍然**被记录**（单独可查），只是不进默认列表。
   * 分类函数在 `src/security/access-channel.ts`，优先级 OPS > ADMIN > USER。
   */
  channel       String  @db.VarChar(8) @default("USER")

  ip         String? @db.VarChar(45)
  deviceHash String? @db.VarChar(64)
  userAgent  String? @db.VarChar(512)
  referer    String? @db.VarChar(256)
  origin     String? @db.VarChar(128)
  acceptLanguage String? @db.VarChar(64)
  contentType    String? @db.VarChar(96)
  errorCode      String? @db.VarChar(48)
  riskLevel      String  @db.VarChar(8)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([statusCode, createdAt])
  // Phase O2 — the ops console's filters and its one correlation key.
  // `requestId` is the ONLY link between an access row and the security event
  // raised for the same request (`SecurityEvent.requestId`), and it had no index,
  // so "what else happened on this request?" was a sequential scan.
  @@index([requestId])
  // `deviceHash` is indexed on `SecurityEvent` but was not indexed here, so
  // device correlation over access history could not use an index either.
  @@index([deviceHash, createdAt])
  @@index([riskLevel, createdAt])
  @@index([isAdmin, createdAt])
  @@index([authenticated, createdAt])
  // 2026-10-06 — 后台默认按 `channel = 'USER'` 读，所以这条索引就是默认视图的索引。
  @@index([channel, createdAt])
}

/// One row per distinct device identifier seen by the platform.
model DeviceIdentity {
  id          String   @id @default(uuid()) @db.Uuid
  deviceHash  String   @unique @db.VarChar(64)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  // Observed User-Agent strings are hashed for correlation, never stored raw.
  userAgents  Json?

  @@index([lastSeenAt])
}

/// Association between a device identifier and the accounts seen on it. This is
/// what makes "one device, many accounts" answerable later.
model DeviceUser {
  deviceHash  String   @db.VarChar(64)
  userId      String   @db.Uuid
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  loginCount  Int      @default(0)

  @@id([deviceHash, userId])
  @@index([userId])
}
