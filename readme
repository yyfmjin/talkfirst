三、完整 Prisma Schema

下面这一份可以作为：

prisma/schema.prisma

的基础版本。

注意：这是产品级设计基础版，不是说复制后完全不需要根据你实际 Prisma 版本调整。特别是 Prisma 新版本对配置文件和 datasource URL 的写法可能有所变化。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// =====================================================
// ENUMS
// =====================================================
//

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum LanguageType {
  NATIVE
  LEARNING
}

enum LanguageLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
  NATIVE
}

enum SocialPlatform {
  INSTAGRAM
  TELEGRAM
  WHATSAPP
  DISCORD
  X
  TIKTOK
  YOUTUBE
  FACEBOOK
  WECHAT
  QQ
  REDDIT
  SNAPCHAT
  OTHER
}

enum SocialVisibility {
  PRIVATE
  CONNECTIONS_ONLY
  AFTER_MUTUAL_APPROVAL
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ConnectionStatus {
  ACTIVE
  BLOCKED
  REMOVED
}

enum ConversationType {
  DIRECT
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
  ICEBREAKER
  CONTACT_REQUEST
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  DELETED
}

enum ReportReason {
  HARASSMENT
  SPAM
  SCAM
  SEXUAL_CONTENT
  HATE_SPEECH
  FAKE_PROFILE
  IMPERSONATION
  UNDERAGE
  ILLEGAL_CONTENT
  SELF_HARM
  EXTERNAL_SCAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ModerationAction {
  NONE
  WARNING
  MESSAGE_BLOCKED
  CONTENT_REMOVED
  TEMPORARY_BAN
  PERMANENT_BAN
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  NEW_MESSAGE
  CONTACT_REQUEST
  CONTACT_ACCEPTED
  CONTACT_REJECTED
