//
// =====================================================
// USER
// =====================================================
//

model User {
  id                String     @id @default(uuid()) @db.Uuid

  email             String?    @unique
  passwordHash      String?

  nickname          String
  avatarUrl         String?
  bio               String?

  birthDate         DateTime?
  gender            Gender?

  countryCode       String?
  countryName       String?

  status            UserStatus @default(PENDING)

  emailVerified     Boolean    @default(false)
  phoneVerified     Boolean    @default(false)

  lastActiveAt      DateTime?
  lastLoginAt       DateTime?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  profile           UserProfile?
  preferences       UserPreference?

  languages         UserLanguage[]
  interests         UserInterest[]
  socialAccounts    SocialAccount[]

  sentRequests      ConnectionRequest[] @relation("SentRequests")
  receivedRequests  ConnectionRequest[] @relation("ReceivedRequests")

  connectionsA      Connection[] @relation("ConnectionUserA")
  connectionsB      Connection[] @relation("ConnectionUserB")

  conversations     ConversationMember[]
  messages          Message[]

  blocksGiven       Block[] @relation("Blocker")
  blocksReceived    Block[] @relation("Blocked")

  reportsMade       Report[] @relation("Reporter")
  reportsReceived   Report[] @relation("ReportedUser")

  posts             UserPost[]
  externalPosts     ExternalPost[]

  notifications     Notification[]
  devices           UserDevice[]

  reputation        UserReputation?

  subscription      Subscription?
  boosts            ProfileBoost[]

  moderationRecords  ModerationRecord[]

  @@index([status])
  @@index([countryCode])
  @@index([lastActiveAt])
  @@index([createdAt])
}

//
// =====================================================
// USER PROFILE
// =====================================================
//

model UserProfile {
  id              String   @id @default(uuid()) @db.Uuid

  userId          String   @unique @db.Uuid

  displayName     String?
  occupation      String?
  education       String?
  locationText    String?

  isDiscoverable  Boolean  @default(true)
  showAge         Boolean  @default(true)
  showCountry     Boolean  @default(true)
  showOnline      Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//
// =====================================================
// USER PREFERENCES
// =====================================================
//

model UserPreference {
  id                    String   @id @default(uuid()) @db.Uuid

  userId                String   @unique @db.Uuid

  minAge                Int?
  maxAge                Int?

  preferredGender       Gender?

  globalSearch          Boolean  @default(true)

  allowMessages         Boolean  @default(true)
  allowConnectionReq    Boolean  @default(true)

  showInRecommendations Boolean  @default(true)

  autoTranslate         Boolean  @default(false)

  syncSocialPosts       Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  countries             UserPreferredCountry[]
  purposes              UserPurpose[]
}

//
// =====================================================
// COUNTRIES
// =====================================================
//

model Country {
  id          String @id @default(uuid()) @db.Uuid

  code        String @unique
  name        String
  nameEn      String

  flagEmoji   String?

  active      Boolean @default(true)

  createdAt   DateTime @default(now())

  preferredBy UserPreferredCountry[]
}

model UserPreferredCountry {
  id           String @id @default(uuid()) @db.Uuid

  userId       String @db.Uuid
  countryId    String @db.Uuid

  user         UserPreference @relation(fields: [userId], references: [id], onDelete: Cascade)
  country      Country        @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([userId, countryId])
}

