# App
NODE_ENV=production
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001

# Ports exposed on host
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL (used inside compose network)
POSTGRES_USER=talkfirst
POSTGRES_PASSWORD=talkfirst
POSTGRES_DB=talkfirst

# Redis
REDIS_URL=redis://localhost:6379

# Auth (MUST override in real deployment)
JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-in-production-min-32-chars

# Seed demo data on first boot (set to "1" to enable)
SEED_ON_BOOT=
ADMIN_BOOTSTRAP_EMAIL=

# Frontend API endpoints (bake into Next.js build)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_BASE_URL=http://localhost:4000

# Object storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Legacy pre-registration gate. Deprecated: superseded by
# ENFORCE_EMAIL_VERIFICATION (SEC-005) below. Kept for compatibility only.
REQUIRE_EMAIL_VERIFICATION=false

# Email verification enforcement (SEC-005)
#
# ENFORCE_EMAIL_VERIFICATION decides whether an account must confirm its e-mail
# before it can use the product:
#   development / test : false -- the flow is exercisable without a mailbox
#   production         : true  -- requires a working SMTP provider
# In production with this on, the API refuses to boot unless MAIL_PROVIDER=smtp
# and the SMTP_* settings are present, so users are never trapped behind mail
# the server cannot send.
ENFORCE_EMAIL_VERIFICATION=false

# Mail transport: console | fake | smtp
#   console -> logs that a message was sent (never the code)
#   fake    -> captures messages in memory (tests)
#   smtp    -> delivers over SMTP (required in production under enforcement)
MAIL_PROVIDER=console

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=
# AI / Translation
AI_API_KEY=
TRANSLATION_API_KEY=

# Social OAuth
SOCIAL_CLIENT_ID=
SOCIAL_CLIENT_SECRET=
