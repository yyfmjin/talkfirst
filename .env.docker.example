# App
NODE_ENV=production
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001

# Ports exposed on host
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL (used inside compose network)
POSTGRES_USER=talkfirst
POSTGRES_PASSWORD=talkfirst
POSTGRES_DB=talkfirst

# Redis
REDIS_URL=redis://localhost:6379

# Auth (MUST override in real deployment)
JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-in-production-min-32-chars

# Security Audit Center (Phase O1)
#
# SECURITY_DEVICE_SALT salts the device identifier (a hash of the normalised
# User-Agent). REQUIRED in production: the API refuses to boot without it,
# because an absent salt silently leaves every deviceHash NULL and makes
# "one device, many accounts" unanswerable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECURITY_DEVICE_SALT=

# TRUST_PROXY is the number of proxy hops in front of the API (Phase O1-5).
# REQUIRED in production, and it has NO safe default: the code falls back to 1,
# and trusting a hop that does not exist lets any caller forge the address
# recorded in AccessLog.ip via an X-Forwarded-For header.
#
#   0 = API exposed directly (no proxy)
#   1 = one reverse proxy in front
#   2 = a CDN in front of a reverse proxy
TRUST_PROXY=0

# Audit retention (Phase O1), in days. 0 means keep forever.
# ACCESS_LOG_RETENTION_DAYS=30
# SECURITY_EVENT_RETENTION_DAYS=180

# Seed demo data on first boot (set to "1" to enable)
SEED_ON_BOOT=
ADMIN_BOOTSTRAP_EMAIL=

# Frontend API endpoints (bake into Next.js build)
#
# ⚠️ 这两个值是**构建期**写死的：改完必须重新构建镜像，重启容器无效。
# 下面保留 localhost 只是为了让你一眼看出它必须被改 —— 两个 Dockerfile 的构建阶段现在会
# 调用 scripts/check-build-env.mjs，发现回环地址会**直接让构建失败**（以前是静默产出
# 一个「浏览器去连自己 localhost」的镜像）。生产示例：
#   NEXT_PUBLIC_API_BASE_URL=https://api.talkfirst.ccwu.cc/api/v1
#   NEXT_PUBLIC_SOCKET_BASE_URL=https://api.talkfirst.ccwu.cc
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_BASE_URL=http://localhost:4000

# Object storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Legacy pre-registration gate. Deprecated: superseded by
# ENFORCE_EMAIL_VERIFICATION (SEC-005) below. Kept for compatibility only.
REQUIRE_EMAIL_VERIFICATION=false

# Email verification enforcement (SEC-005)
#
# ENFORCE_EMAIL_VERIFICATION decides whether an account must confirm its e-mail
# before it can use the product:
#   development / test : false -- the flow is exercisable without a mailbox
#   production         : true  -- requires a working SMTP provider
# In production with this on, the API refuses to boot unless MAIL_PROVIDER=smtp
# and the SMTP_* settings are present, so users are never trapped behind mail
# the server cannot send.
ENFORCE_EMAIL_VERIFICATION=false

# Mail transport: console | fake | smtp
#   console -> logs that a message was sent (never the code)
#   fake    -> captures messages in memory (tests)
#   smtp    -> delivers over SMTP (required in production under enforcement)
MAIL_PROVIDER=console

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=
# AI / Translation
AI_API_KEY=
TRANSLATION_API_KEY=

# Social OAuth
SOCIAL_CLIENT_ID=
SOCIAL_CLIENT_SECRET=

# ---------------------------------------------------------------
# 以下为 2026-10-03 新增的键。模板此前缺失它们，用 Docker 方式部署会直接缺配置，
# 而其中 TOKEN_ENCRYPTION_KEY 与 API_PUBLIC_URL 缺失会让 API **拒绝启动**。
# ---------------------------------------------------------------

# 第三方社交账号动态同步（绑定第三方账号并同步最近动态）
#
# TOKEN_ENCRYPTION_KEY 加密库里保存的第三方 OAuth token（AES-256-GCM）。
# 生产必填，且**故意没有默认值**：API 缺它会拒绝启动 —— 否则一次遗忘就会把真实
# 用户的社交凭据用仓库里公开可读的密钥加密。
#   生成：openssl rand -base64 48
# 轮换它会让已保存的 token 全部无法解密，用户需重新绑定（没有恢复路径）。
TOKEN_ENCRYPTION_KEY=

SOCIAL_SYNC_ENABLED=false
SOCIAL_SYNC_INTERVAL_MINUTES=30

# API_PUBLIC_URL 是 API 的对外地址，Google 回调地址由它派生（两者不能漂移），
# 且不能是 loopback：生产 + 已配置 Google 时，loopback 会让 API 以「生产环境不
# 允许 loopback 回调地址」为由拒绝启动。
API_PUBLIC_URL=

# 面向浏览器的上传资源基址（头像 / 动态媒体）。留空时由 API 按请求推导。
PUBLIC_UPLOAD_BASE_URL=

# 动态视频上传与转码（API 所在环境需已安装 ffmpeg / ffprobe）。
# VIDEO_MAX_UPLOAD_MB 是**原始上传**上限（还受 Nginx client_max_body_size 制约），
# VIDEO_TARGET_MAX_MB 是**压缩后**目标，两者不可合并。
VIDEO_MAX_UPLOAD_MB=90
VIDEO_TARGET_MAX_MB=15
VIDEO_MAX_WIDTH=1920
VIDEO_MAX_HEIGHT=1080
VIDEO_PROCESSING_TIMEOUT_MS=300000
VIDEO_MAX_CONCURRENT_JOBS=1

# Google 快捷登录
#
# OAUTH_PROVIDERS 留空 = 只启用「凭据确实存在」的 provider。
# OAUTH_DEV_PROVIDER=true 是本地假 OIDC provider（开发用），生产必须不设或为 false。
OAUTH_PROVIDERS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAUTH_DEV_PROVIDER=true

# DATABASE_URL / DIRECT_URL 由 docker-compose 直接注入给 api 服务（指向 compose
# 网络内的 postgres:5432），用 Docker 部署时不必在此重复。裸机部署才需要：
# DATABASE_URL=postgresql://talkfirst:<password>@localhost:5432/talkfirst?schema=public
# DIRECT_URL=postgresql://talkfirst:<password>@localhost:5432/talkfirst?schema=public
