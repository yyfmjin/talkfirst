# App
NODE_ENV=production
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001

# Ports exposed on host
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL (used inside compose network)
POSTGRES_USER=talkfirst
POSTGRES_PASSWORD=talkfirst
POSTGRES_DB=talkfirst

# Redis
REDIS_URL=redis://localhost:6379

# Auth (MUST override in real deployment)
JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-in-production-min-32-chars

# Security Audit Center (Phase O1)
#
# SECURITY_DEVICE_SALT salts the device identifier (a hash of the normalised
# User-Agent). REQUIRED in production: the API refuses to boot without it,
# because an absent salt silently leaves every deviceHash NULL and makes
# "one device, many accounts" unanswerable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECURITY_DEVICE_SALT=

# TRUST_PROXY is the number of proxy hops in front of the API (Phase O1-5).
# REQUIRED in production, and it has NO safe default: the code falls back to 1,
# and trusting a hop that does not exist lets any caller forge the address
# recorded in AccessLog.ip via an X-Forwarded-For header.
#
#   0 = API exposed directly (no proxy)
#   1 = one reverse proxy in front
#   2 = a CDN in front of a reverse proxy
TRUST_PROXY=0

# Audit retention (Phase O1), in days. 0 means keep forever.
# ACCESS_LOG_RETENTION_DAYS=30
# SECURITY_EVENT_RETENTION_DAYS=180

# Seed demo data on first boot (set to "1" to enable)
SEED_ON_BOOT=
ADMIN_BOOTSTRAP_EMAIL=

# Frontend API endpoints (bake into Next.js build)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_BASE_URL=http://localhost:4000

# Object storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Legacy pre-registration gate. Deprecated: superseded by
# ENFORCE_EMAIL_VERIFICATION (SEC-005) below. Kept for compatibility only.
REQUIRE_EMAIL_VERIFICATION=false

# Email verification enforcement (SEC-005)
#
# ENFORCE_EMAIL_VERIFICATION decides whether an account must confirm its e-mail
# before it can use the product:
#   development / test : false -- the flow is exercisable without a mailbox
#   production         : true  -- requires a working SMTP provider
# In production with this on, the API refuses to boot unless MAIL_PROVIDER=smtp
# and the SMTP_* settings are present, so users are never trapped behind mail
# the server cannot send.
ENFORCE_EMAIL_VERIFICATION=false

# Mail transport: console | fake | smtp
#   console -> logs that a message was sent (never the code)
#   fake    -> captures messages in memory (tests)
#   smtp    -> delivers over SMTP (required in production under enforcement)
MAIL_PROVIDER=console

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=
# AI / Translation
AI_API_KEY=
TRANSLATION_API_KEY=

# Social OAuth
SOCIAL_CLIENT_ID=
SOCIAL_CLIENT_SECRET=
